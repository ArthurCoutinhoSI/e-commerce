# Runtime configuration for the containerized stack.
# Copy to .env and set POSTGRES_PASSWORD before starting the stack.
# .env is gitignored and must never be committed.

# Port each service listens on inside its container.
# The API gateway is the only service published to the host.
API_GATEWAY_PORT=8080
PRODUCT_SERVICE_PORT=3001
PAYMENT_SERVICE_PORT=3002

# Production images always run with this value.
NODE_ENV=production

# PostgreSQL container configuration.
# POSTGRES_PASSWORD is required; Compose refuses to start without it.
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=postgres

# Services connect over the internal Compose network using standard PG* variables.
# Compose supplies these values; they are documented here for host-only development.
#   PGHOST=database
#   PGPORT=5432
#   PGUSER=${POSTGRES_USER}
#   PGPASSWORD=${POSTGRES_PASSWORD}
#   PGDATABASE=products   (product-service)
#   PGDATABASE=payments   (payment-service)

# Prometheus (only the UI is published to the host).
PROMETHEUS_PORT=9090

# Service-to-service URLs.
# Defaults below keep the non-containerized `npm run dev` workflow working.
# Docker Compose overrides these with internal service DNS names:
#   PRODUCT_SERVICE_URL=http://product-service:3001
#   PAYMENT_SERVICE_URL=http://payment-service:3002
PRODUCT_SERVICE_URL=http://localhost:3001
PAYMENT_SERVICE_URL=http://localhost:3002
