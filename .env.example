# Runtime configuration for the containerized stack.
# Copy to .env only if you need to override Compose defaults.

# Port each service listens on inside its container.
# The API gateway is the only service published to the host.
API_GATEWAY_PORT=8080
PRODUCT_SERVICE_PORT=3001
PAYMENT_SERVICE_PORT=3002

# Production images always run with this value.
NODE_ENV=production

# Service-to-service URLs.
# Defaults below keep the non-containerized `npm run dev` workflow working.
# Docker Compose overrides these with internal service DNS names:
#   PRODUCT_SERVICE_URL=http://product-service:3001
#   PAYMENT_SERVICE_URL=http://payment-service:3002
PRODUCT_SERVICE_URL=http://localhost:3001
PAYMENT_SERVICE_URL=http://localhost:3002
